# Cópie para .env (não vai para o Git).
# Onde está o banco: banco da sua conta no MotherDuck (padrão), um compartilhamento ou um arquivo local.
DATABASE=md:bdr
# DATABASE=/caminho/para/bdr_final.duckdb
# DATABASE=md:_share/bdr/<codigo>
# Token do MotherDuck (só se DATABASE começar com md:). Fica SOMENTE no servidor.
MOTHERDUCK_TOKEN=
# Origens permitidas no navegador (separadas por vírgula). Com o proxy do Next.js (rewrites) isso quase não é usado.
CORS_ORIGINS=http://localhost:3000
# Tempo de cache das respostas, em segundos (os dados são históricos).
CACHE_TTL_SEGUNDOS=3600
